---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Button from "../ui/button.astro";
import JobsList from "../ui/jobs-list";
import { SHOW_JOBS } from "../config/features";

if (!SHOW_JOBS) return Astro.redirect("/");

const siteOrigin = Astro.site ?? new URL("https://www.ui-skills.com");
const jobsUrl = new URL("/jobs", siteOrigin).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Design engineering jobs",
  description:
    "The latest design engineering jobs from companies building thoughtful digital products.",
  url: jobsUrl,
};
---

<Layout
  structuredData={structuredData}
  title="Design engineering jobs | UI Skills"
  description="Browse the latest design engineering jobs from companies hiring designers who can think in systems and build exceptional interfaces."
>
  <div class="relative flex min-h-dvh flex-col items-center justify-start">
    <main class="container-3xl relative mt-20">
      <div class="mx-auto flex w-full flex-col gap-10">
        <div class="flex items-start justify-between gap-5">
          <div class="flex flex-col gap-3">
            <h1 class="type-h1 text-content-primary">Jobs</h1>
            <p class="type-body-md text-content-secondary">
              The latest design engineering jobs from companies building
              thoughtful digital products.
            </p>
          </div>
          <Button href="/jobs/post" variant="secondary" size="md">
            Post a job
          </Button>
        </div>

        <JobsList client:load />
      </div>
    </main>
  </div>
</Layout>
