---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import { playbook } from "../data/playbook";
import { skills } from "../data/skills";
import AgentAccessStart from "../ui/agent-access-start.astro";
import PlaybookCard from "../ui/playbook-card.astro";
import SkillCard from "../ui/skill-card.astro";
import { ChevronRightIcon } from "@heroicons/react/24/outline";

const MAX_SKILLS = 20;

const FEATURED_PATH_SLUGS = [
  "ibelick/ui-skills-root",
  "ibelick/improve-ui",
  "anthropics/frontend-design",
  "mengto/design-taste-frontend",
  "emilkowalski/improve-animations",
  "millionco/improve-react",
  "shadcn/improve",
  "jakubkrehel/better-ui",
  "0xdesign/design-lab",
  "nextlevelbuilder/ui-ux-pro-max",
  "dammyjay93/interface-design",
  "raphaelsalaja/12-principles-of-animation",
  "pbakaus/impeccable",
  "bencium/bencium-innovative-ux-designer",
  "leonxlnx/gpt-tasteskill",
  "antfu/web-design-guidelines",
  "rams/rams",
  "wshobson/interaction-design",
  "addyosmani/frontend-ui-engineering",
] as const;

const skillByPathSlug = new Map(skills.map((skill) => [skill.pathSlug, skill]));
const isDefined = <T,>(value: T | undefined): value is T => value !== undefined;

const displayedSkills = FEATURED_PATH_SLUGS.map((pathSlug) =>
  skillByPathSlug.get(pathSlug),
)
  .filter(isDefined)
  .slice(0, MAX_SKILLS)
  .map((skill) => {
    const owner = skill.sourceKey ?? "ibelick";

    return {
      ...skill,
      owner,
      ownerLabel: skill.sourceLabel ?? "Ibelick",
      avatarUrl: `https://github.com/${owner}.png?size=40`,
    };
  });

const featuredPlaybook = playbook
  .slice(0, 4)
  .map((entry) => {
    const sourceSkill = skills.find((skill) => skill.slug === entry.skill);

    return sourceSkill ? entry : null;
  })
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

const designMdAssets = [
  ["Mintlify", "https://assets.querrel.com/design.md/mintlify/mintlify-logo.webp"],
  ["Atlassian", "https://assets.querrel.com/design.md/atlassian/atlassian-logo.webp"],
  ["Amplitude", "https://assets.querrel.com/design.md/amplitude/amplitude-logo.webp"],
  ["Firecrawl", "https://assets.querrel.com/design.md/firecrawl/firecrawl-logo.webp"],
  ["Vercel", "https://assets.querrel.com/design.md/vercel/vercel-logo.webp"],
  ["QuiverAI", "https://assets.querrel.com/design.md/quiverai/quiverai-logo.webp"],
  ["Voltagent", "https://assets.querrel.com/design.md/voltagent/voltagent-logo.webp"],
  ["UNICEF", "https://assets.querrel.com/design.md/unicef/unicef-logo.webp"],
  ["Open Food Facts", "https://assets.querrel.com/design.md/openfoodfacts/openfoodfacts-logo.webp"],
  ["Nuxt", "https://assets.querrel.com/design.md/nuxt/nuxt-logo.webp"],
  ["Hyperframes", "https://assets.querrel.com/design.md/hyperframes/hyperframes-logo.webp"],
  ["Culture Amp", "https://assets.querrel.com/design.md/cultureamp/cultureamp-logo.webp"],
  ["DSFR", "https://assets.querrel.com/design.md/dsfr/dsfr-logo.webp"],
  ["Ant Design", "https://assets.querrel.com/design.md/antdesign/antdesign-logo.webp"],
  ["Executor", "https://assets.querrel.com/design.md/executor/executor-logo.webp"],
] as const;
---

<Layout
  title="UI Skills for Design Engineers | UI Skills"
  description="UI Skills is a collection of design-engineering skills for accessibility, motion, frontend craft, and interface quality."
>
  <div
    class="relative flex min-h-dvh flex-col items-center justify-end"
  >
    <div class="relative mt-20 container-3xl">
      <div class="mx-auto flex w-full flex-col gap-10">
        <header class="container-sm ml-0 px-0 text-left">
          <h1 class="type-h1 text-left text-content-primary">
            Curated skills for design engineering
          </h1>
        </header>

        <section class="flex flex-col gap-7">
          <AgentAccessStart />

          <div class="flex flex-col gap-2">
            <a
              href="/skills"
              class="section-title type-body-md inline-flex items-center gap-0.5 self-start font-[450] text-content-secondary"
            >
              <span>Skills</span>
              <ChevronRightIcon className="size-4 text-content-muted" aria-hidden="true" />
            </a>
            <div class="flex flex-col">
              {
                displayedSkills.map((skill) => (
                  <SkillCard
                    href={`/skills/${skill.pathSlug}`}
                    slug={skill.slug}
                    description={skill.description}
                    ownerLabel={skill.ownerLabel}
                    avatarUrl={skill.avatarUrl}
                    variant="list"
                  />
                ))
              }
            </div>
          </div>
        </section>

        <div class="flex flex-col gap-5">
          <a
            href="/design.md"
            class="section-title type-body-md inline-flex items-center gap-0.5 self-start font-[450] text-content-secondary"
          >
            <span>Design.md</span>
            <ChevronRightIcon className="size-4 text-content-muted" aria-hidden="true" />
          </a>
          <div class="flex gap-3 overflow-hidden">
            {
              designMdAssets.map(([name, src]) => (
                <img
                  src={src}
                  alt={name}
                  width="40"
                  height="40"
                  loading="lazy"
                  class="size-10 shrink-0 rounded-xl border border-line-default"
                />
              ))
            }
          </div>
        </div>

        <div class="flex flex-col gap-5">
          <a
            href="/playbook"
            class="section-title type-body-md inline-flex items-center gap-0.5 self-start font-[450] text-content-secondary"
          >
            <span>Learn</span>
            <ChevronRightIcon className="size-4 text-content-muted" aria-hidden="true" />
          </a>
          <div class="grid gap-3 sm:grid-cols-2">
            {
              featuredPlaybook.map((entry) => (
                <PlaybookCard
                  href={`/playbook/${entry.slug}`}
                  title={entry.title}
                  description={entry.description}
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
