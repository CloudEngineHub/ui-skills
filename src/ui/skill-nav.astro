---
import { ChevronLeftIcon, ChevronRightIcon } from "@heroicons/react/24/outline";

type Props = {
  previousHref?: string;
  nextHref?: string;
};

const { previousHref, nextHref } = Astro.props as Props;
---

<div
  class="border-line-default inline-flex items-stretch overflow-hidden rounded-[8px] border bg-surface-default"
>
  {
    previousHref ? (
      <a
        href={previousHref}
        aria-label="Previous skill"
        class="text-content-primary hover:bg-fill-subtle inline-flex size-8 items-center justify-center transition-colors"
      >
        <ChevronLeftIcon className="size-4" aria-hidden="true" />
      </a>
    ) : (
      <span
        aria-label="Previous skill unavailable"
        class="text-content-extra-muted inline-flex size-8 items-center justify-center"
      >
        <ChevronLeftIcon className="size-4" aria-hidden="true" />
      </span>
    )
  }
  <span class="bg-fill-strong w-px self-stretch" aria-hidden="true"></span>
  {
    nextHref ? (
      <a
        href={nextHref}
        aria-label="Next skill"
        class="text-content-primary hover:bg-fill-subtle inline-flex size-8 items-center justify-center transition-colors"
      >
        <ChevronRightIcon className="size-4" aria-hidden="true" />
      </a>
    ) : (
      <span
        aria-label="Next skill unavailable"
        class="text-content-extra-muted inline-flex size-8 items-center justify-center"
      >
        <ChevronRightIcon className="size-4" aria-hidden="true" />
      </span>
    )
  }
</div>
