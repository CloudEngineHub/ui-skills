---
import Card from "./card.astro";
import Command from "./command.astro";
import Button from "./button.astro";
import { ArrowRightIcon } from "@heroicons/react/24/outline";

const accessOptions = [
  {
    label: "CLI",
    description: "Run the UI Skills CLI from your terminal.",
    href: "/cli",
  },
  {
    label: "MCP",
    description: "Connect your agent to the UI Skills catalog.",
    href: "/mcp/docs",
  },
];
---

<div>
  <div class="grid gap-3 sm:grid-cols-2">
    {
      accessOptions.map((option) => (
        <Card className="h-full transition-colors hover:border-content-extra-muted hover:bg-fill-subtle">
          <Button
            href={option.href}
            variant="ghost"
            size="sm"
            className="absolute right-1 top-1 size-7 p-1 focus-visible:outline-content-primary"
            aria-label={`Open ${option.label} installation guide`}
          >
            <ArrowRightIcon className="size-4" aria-hidden="true" />
          </Button>
          <div class="card-description flex flex-col gap-1.5 pr-8">
            <div class="type-body-md text-content-primary">{option.label}</div>
            <div class="type-body-md text-content-secondary">
              {option.description}
            </div>
          </div>
          {option.label === "CLI" ? <Command command="npx ui skills" /> : null}
        </Card>
      ))
    }
  </div>
</div>
