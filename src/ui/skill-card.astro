---
type Props = {
  href: string;
  slug: string;
  description?: string;
  ownerLabel?: string;
  avatarUrl?: string;
  hideTitle?: boolean;
  ariaLabel?: string;
};

const { href, slug, description, ownerLabel, avatarUrl, hideTitle } =
  Astro.props as Props;
---

<a
  href={href}
  class="hover:border-content-extra-muted hover:bg-fill-subtle border-line-default relative flex flex-col justify-between rounded-[12px] border bg-transparent px-6 py-4 transition-colors"
>
  <div class="flex flex-col gap-3">
    {hideTitle ? null : <div class="text-content-primary font-[450]">{slug}</div>}
    {
      description ? (
        <div class="text-content-secondary line-clamp-3 text-[14px] leading-snug">
          {description}
        </div>
      ) : null
    }
    {
      ownerLabel && avatarUrl ? (
        <div class="mt-1 flex items-center gap-2">
          <img
            src={avatarUrl}
            alt={`${ownerLabel} avatar`}
            width="20"
            height="20"
            loading="lazy"
            class="border-line-default size-5 rounded-full border"
          />
          <span class="text-content-secondary text-[12px]">{ownerLabel}</span>
        </div>
      ) : null
    }
  </div>
</a>
