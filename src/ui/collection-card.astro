---
type Props = {
  href: string;
  title: string;
  description: string;
};

const { href, title, description } = Astro.props as Props;
---

<a
  href={href}
  class="hover:border-content-extra-muted hover:bg-fill-subtle relative flex h-full flex-col justify-between rounded-[12px] border border-line-default bg-transparent px-6 py-4 transition-colors"
>
  <div class="flex flex-col gap-3">
    <div class="text-content-primary font-[450]">{title}</div>
    <div class="text-content-secondary line-clamp-3 text-[14px] leading-snug">
      {description}
    </div>
  </div>
</a>
